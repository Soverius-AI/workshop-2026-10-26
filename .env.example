# Local llama-server in Docker is the default. No API key is required.
# Native scripts use http://127.0.0.1:8080/v1; containers use http://llama:8080/v1.
LLM_MODEL=Gemma
LLM_API_KEY=
MASTRA_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true

# Optional OpenRouter: explicitly set all three values in .env.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=your-openrouter-model-id
# LLM_API_KEY=your-openrouter-api-key

# Unit 3: switch the incident chat from the Unit 1 client to your Mastra agent.
# FACILITY_CHAT_MODE=mastra
