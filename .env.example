# Copy this file to .env in the repository root before Unit 1.
# Native Node and Docker reach the same server at different addresses.
LLM_BASE_URL=http://localhost:8080/v1
LLM_DOCKER_BASE_URL=http://llama:8080/v1
LLM_MODEL=Gemma
LLM_API_KEY=

# All document and question embeddings use OpenRouter.
EMBED_BASE_URL=https://openrouter.ai/api/v1
EMBED_DOCKER_BASE_URL=https://openrouter.ai/api/v1
EMBED_MODEL=baai/bge-m3
EMBED_API_KEY=your-openrouter-api-key
EMBED_SPACE_ID=baai-bge-m3-v1
DOCUMENT_PREFIX=
QUERY_PREFIX=

# The incident backend retrieves only the imported practice documents.
RAG_BASE_URL=http://localhost:4341
RAG_SERVICE_TOKEN=local-workshop-rag

# OpenRouter: replace both LLM URLs, the model and the key above.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_DOCKER_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-26b-a4b-it
# LLM_API_KEY=your-openrouter-api-key

MASTRA_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true

# Unit 2: set rag after implementing chat-rag.mts. Unit 3: set mastra.
FACILITY_CHAT_MODE=local
