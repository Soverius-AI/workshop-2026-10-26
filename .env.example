# Copy this file to .env in the repository root before Unit 1.
# These URLs are for the provided Docker Compose commands.
LLM_BASE_URL=http://llama:8080/v1
LLM_MODEL=Gemma
LLM_API_KEY=

# Embeddings stay local when chat and agents use OpenRouter.
EMBED_BASE_URL=http://llama:8080/v1
EMBED_MODEL=workshop-embed
EMBED_API_KEY=

# OpenRouter: replace the three LLM values above.
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=google/gemma-4-26b-a4b-it
# LLM_API_KEY=your-openrouter-api-key

MASTRA_TELEMETRY_DISABLED=1
COPILOTKIT_TELEMETRY_DISABLED=true

# Unit 3: connect the incident chat to your Mastra agent.
# FACILITY_CHAT_MODE=mastra
